{
  "version": "1",
  "targetAgent": "pi",
  "skillsAgentFlag": "pi",
  "steps": [
    {
      "id": "pi-package-pi-ignore",
      "kind": "pi-extension-placement",
      "bundlePath": "pi-extensions/pi-ignore",
      "requires": [
        "jq"
      ],
      "optional": false,
      "source": "catalog"
    },
    {
      "id": "pi-package-pi-subagents",
      "kind": "pi-install",
      "command": "pi install -l npm:pi-subagents@latest",
      "requires": [
        "jq",
        "pi"
      ],
      "optional": false,
      "source": "catalog"
    },
    {
      "id": "pi-package-improvement-scanner",
      "kind": "pi-extension-placement",
      "bundlePath": "pi-extensions/improvement-scanner",
      "requires": [
        "jq"
      ],
      "optional": false,
      "source": "catalog"
    },
    {
      "id": "pi-package-model-save",
      "kind": "pi-extension-placement",
      "bundlePath": "pi-extensions/model-save",
      "requires": [
        "jq"
      ],
      "optional": false,
      "source": "catalog"
    },
    {
      "id": "pi-package-role-router",
      "kind": "pi-extension-placement",
      "bundlePath": "pi-extensions/role-router",
      "requires": [
        "jq"
      ],
      "optional": false,
      "source": "catalog"
    },
    {
      "id": "pi-package-ponytail",
      "kind": "pi-install",
      "command": "pi install -l npm:@dietrichgebert/ponytail",
      "requires": [
        "jq",
        "pi"
      ],
      "optional": false,
      "source": "catalog"
    }
  ]
}