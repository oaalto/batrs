{
  "name": "@oaalto-kodanbce/pi-ignore",
  "version": "1.1.2",
  "type": "module",
  "description": "Pi extension: .piignore negation rules make selected gitignored files discoverable to the agent",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oaalto-kodan/pi-extensions.git",
    "directory": "packages/pi-ignore"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/piignore.ts"
    ]
  },
  "scripts": {
    "test": "node --test --experimental-strip-types tests/piignore.test.ts"
  },
  "files": [
    "extensions",
    "tests",
    "README.md",
    "package.json"
  ]
}
